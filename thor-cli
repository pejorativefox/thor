#!/usr/bin/env python3
"""thor — launch Thor editor."""
import os
import sys

# Repo path baked in by ./install.sh so `import thor` works without a pip
# install (some systems ship python without pip). Empty in the checkout.
_THOR_BAKED_SRC = ""


def _ensure_thor_importable() -> None:
    """Prepend the Thor checkout root to sys.path if `thor` is unimportable."""
    try:
        import thor  # noqa: F401
        return
    except ImportError:
        pass
    candidates = []
    try:
        candidates.append(os.path.dirname(os.path.realpath(__file__)))
    except Exception:
        pass
    for cand in (os.environ.get("THOR_SRC_DIR") or "", _THOR_BAKED_SRC,
                 os.path.expanduser("~/repos/thor")):
        if cand:
            candidates.append(cand)
    for cand in candidates:
        if cand and os.path.isfile(os.path.join(cand, "thor", "app.py")):
            if cand not in sys.path:
                sys.path.insert(0, cand)
            return


_ensure_thor_importable()

from thor.app import main
if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
