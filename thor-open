#!/usr/bin/env python3
"""thor-open — open file:line in Thor."""
from __future__ import annotations

import os
import re
import subprocess
import sys

USAGE = "usage: thor-open 'path/to/file.cs[:line[:col]]' [...]"


def parse_location(text: str) -> tuple[str, int | None, int | None]:
    cleaned = (text or "").strip().strip("'\"")
    match = re.match(r"^(.*?)\((\d+)(?:[,:](\d+))?\)\s*$", cleaned)
    if match:
        path, line, col = match.group(1), match.group(2), match.group(3)
    else:
        match = re.match(r"^(.*?):(\d+)(?::(\d+))?\s*$", cleaned)
        if not match:
            return cleaned, None, None
        path, line, col = match.group(1), match.group(2), match.group(3)
    try:
        line_no = max(1, int(line)) if line else None
    except (TypeError, ValueError):
        line_no = None
    try:
        col_no = max(1, int(col)) if col else None
    except (TypeError, ValueError):
        col_no = None
    return path.strip(), line_no, col_no


def open_location(path: str, line: int | None, col: int | None = None) -> int:
    if not path:
        print("thor-open: empty path", file=sys.stderr)
        return 2
    # If file doesn't exist yet, still try — Thor will create tab
    thor_bin = os.path.join(os.path.dirname(__file__), "thor-cli")
    argv: list[str]
    if os.path.isfile(thor_bin):
        argv = [sys.executable, thor_bin]
    else:
        argv = ["thor"]
    if line:
        argv.append(f"+{line}")
    argv.append(path)
    try:
        subprocess.Popen(
            argv,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    except FileNotFoundError:
        print("thor-open: thor not on PATH", file=sys.stderr)
        return 127
    except OSError as exc:
        print(f"thor-open: failed to launch thor: {exc}", file=sys.stderr)
        return 1
    return 0


def main(argv: list[str]) -> int:
    if len(argv) < 2 or argv[1] in ("-h", "--help"):
        print(USAGE)
        return 0 if len(argv) > 1 else 2
    code = 0
    for arg in argv[1:]:
        path, line, col = parse_location(arg)
        result = open_location(path, line, col)
        code = code or result
    return code


if __name__ == "__main__":
    sys.exit(main(sys.argv))
