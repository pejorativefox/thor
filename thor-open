#!/usr/bin/env python3
"""thor-open — open file:line in Thor (forwards to live window when possible)."""
from __future__ import annotations

import os
import re
import subprocess
import sys

USAGE = "usage: thor-open 'path/to/file.cs[:line[:col]]' [...]"


def parse_location(text: str) -> tuple[str, int | None, int | None]:
    """Split ``path[:line[:col]]`` / ``path(line[,col])`` into parts.

    Right-anchored numeric suffixes only; ``C:\\foo:10:5`` keeps its drive
    letter and ``a:1:2:3`` treats the extra ``:3`` as part of the path
    (only the last two numeric groups count as line/col).
    """
    cleaned = (text or "").strip().strip("'\"")
    match = re.match(r"^(.*?)\((\d+)(?:[,:](\d+))?\)\s*$", cleaned)
    if match:
        path, line, col = match.group(1), match.group(2), match.group(3)
    else:
        path, line, col = _split_colon_suffix(cleaned)
        if line is None:
            return cleaned, None, None
    try:
        line_no = max(1, int(line)) if line else None
    except (TypeError, ValueError):
        line_no = None
    try:
        col_no = max(1, int(col)) if col else None
    except (TypeError, ValueError):
        col_no = None
    return path.strip(), line_no, col_no


def _split_colon_suffix(text: str) -> tuple[str, str | None, str | None]:
    # Drive-letter prefix (``C:/...`` / ``C:\\...``) is part of the path.
    prefix = ""
    rest = text
    if len(rest) >= 3 and rest[1] == ":" and rest[2] in ("/", "\\"):
        prefix, rest = rest[:2], rest[2:]
    elif len(rest) >= 2 and rest[1] == ":" and "/" not in rest and "\\" not in rest:
        # Bare ``C:foo`` drive-relative path — keep the drive.
        prefix, rest = rest[:2], rest[2:]
    parts = rest.split(":")
    # Peel up to two trailing numeric groups as line/col.
    nums: list[str] = []
    while parts and len(nums) < 2 and parts[-1].strip().isdigit():
        nums.insert(0, parts.pop().strip())
    if not nums:
        return text, None, None
    path = prefix + ":".join(parts)
    if not path:
        path = text
        return path, None, None
    line = nums[0] if len(nums) >= 1 else None
    col = nums[1] if len(nums) == 2 else None
    # Single numeric suffix after a drive-relative bare path like ``a:1``
    # is line 1 of file ``a`` — correct. But ``a:1:2:3`` leaves path
    # ``a:1`` with line 2 col 3, preserving the extra group in the path
    # instead of misreading file ``a`` line 1 col 2.
    return path, line, col
def open_location(path: str, line: int | None, col: int | None = None) -> int:
    if not path:
        print("thor-open: empty path", file=sys.stderr)
        return 2
    # Resolve absolute path so running Thor instance (with possibly different CWD) opens it correctly
    abs_path = os.path.abspath(os.path.expanduser(path))
    # Forward into the live window when the file lives under an
    # already-open root (one window per folder): focus + open at line.
    try:
        sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
        from thor import ipc as _ipc  # type: ignore

        live = _ipc.find_live_root_for_path(abs_path)
        if live:
            lines = {abs_path: (line or 1, col)} if line else {}
            if _ipc.notify_existing(live, [abs_path], lines):
                return 0
    except Exception:
        pass
    finally:
        try:
            sys.path.remove(os.path.dirname(os.path.abspath(__file__)))
        except ValueError:
            pass
    # If file doesn't exist yet, still try — Thor will create tab
    thor_bin = os.path.join(os.path.dirname(__file__), "thor-cli")
    argv: list[str]
    if os.path.isfile(thor_bin):
        argv = [sys.executable, thor_bin]
    else:
        argv = ["thor"]
    if line:
        if col:
            argv.append(f"+{line}:{col}")
        else:
            argv.append(f"+{line}")
    argv.append(abs_path)
    try:
        subprocess.Popen(
            argv,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    except FileNotFoundError:
        print("thor-open: thor not on PATH", file=sys.stderr)
        return 127
    except OSError as exc:
        print(f"thor-open: failed to launch thor: {exc}", file=sys.stderr)
        return 1
    return 0


def main(argv: list[str]) -> int:
    if len(argv) < 2 or argv[1] in ("-h", "--help"):
        print(USAGE)
        return 0 if len(argv) > 1 else 2
    code = 0
    for arg in argv[1:]:
        path, line, col = parse_location(arg)
        result = open_location(path, line, col)
        code = code or result
    return code


if __name__ == "__main__":
    sys.exit(main(sys.argv))
