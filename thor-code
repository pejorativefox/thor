#!/usr/bin/env python3
"""thor-code — open a folder in Thor (code . equivalent).

One editor per process, one window per folder: this focuses the live
window for an already-open root (via per-root IPC) and only spawns
`thor <folder>` otherwise. `--new-window` forces a duplicate process.
"""

from __future__ import annotations

import os
import subprocess
import sys

# Repo path baked in by ./install.sh so `import thor` works without a pip
# install (some systems ship python without pip). Empty in the checkout.
_THOR_BAKED_SRC = ""


def _ensure_thor_importable() -> None:
    """Prepend the Thor checkout root to sys.path if `thor` is unimportable."""
    try:
        import thor  # noqa: F401
        return
    except ImportError:
        pass
    candidates = []
    try:
        candidates.append(os.path.dirname(os.path.realpath(__file__)))
    except Exception:
        pass
    for cand in (os.environ.get("THOR_SRC_DIR") or "", _THOR_BAKED_SRC,
                 os.path.expanduser("~/repos/thor")):
        if cand:
            candidates.append(cand)
    for cand in candidates:
        if cand and os.path.isfile(os.path.join(cand, "thor", "app.py")):
            if cand not in sys.path:
                sys.path.insert(0, cand)
            return


def _thor_import_error(prog: str) -> int:
    print(f"{prog}: thor package not found; re-run ./install.sh from your "
          "checkout or set THOR_SRC_DIR=/path/to/thor", file=sys.stderr)
    return 1


_ensure_thor_importable()

USAGE = "usage: thor-code [--new-window] [folder]"

VERSION = "0.1.0"

def resolve_target(argv: list[str]) -> str | None:
    args = [a for a in argv[1:] if a not in ("--new-window", "-n")]
    if not args:
        return os.path.abspath(".")
    if args[0] in ("-h", "--help", "--version"):
        return None
    return os.path.abspath(os.path.expanduser(args[0]))


def _wants_new_window(argv: list[str]) -> bool:
    return any(a in ("--new-window", "-n") for a in argv[1:])


def launch(target: str, extra_args: list[str] | None = None) -> int:
    if not os.path.isdir(target):
        print(f"thor-code: not a folder: {target}", file=sys.stderr)
        return 2
    # Already live: focus it instead of spawning a duplicate that would
    # just exit 2 to DEVNULL. The owner presents its window.
    if not (extra_args and any(a in ("--new-window", "-n") for a in extra_args)):
        try:
            _ensure_thor_importable()
            from thor import ipc as _ipc  # type: ignore

            if _ipc.is_root_live(target):
                if _ipc.notify_existing(target):
                    print(f"thor-code: {target} is already open; focused existing window", file=sys.stderr)
                    return 0
        except Exception:
            pass
    # Isolated processes: no pending-root handoff file anymore. Just
    # launch thor; the child takes the same-root lock or focuses the owner.
    # Launch thor (this process's thor-cli or installed thor)
    thor_bin = os.path.join(os.path.dirname(__file__), "thor-cli")
    if not os.path.isfile(thor_bin):
        thor_bin = "thor"
    argv = [*(extra_args or []), target]
    # Fail loudly instead of spawning a child that dies silently to DEVNULL.
    _ensure_thor_importable()
    try:
        import thor  # noqa: F401
    except ImportError:
        return _thor_import_error("thor-code")
    try:
        subprocess.Popen(
            [sys.executable, thor_bin, *argv] if os.path.isfile(thor_bin) and thor_bin.endswith("thor-cli") else [thor_bin, *argv],
            cwd=target,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    except FileNotFoundError:
        print("thor-code: thor not on PATH", file=sys.stderr)
        return 127
    except OSError as exc:
        print(f"thor-code: failed to launch thor: {exc}", file=sys.stderr)
        return 1
    return 0

def main(argv: list[str]) -> int:
    if len(argv) > 1 and argv[1] in ("--version", "-v"):
        print(f"thor-code {VERSION}")
        return 0
    target = resolve_target(argv)
    if target is None:
        print(USAGE)
        return 0
    extra = ["--new-window"] if _wants_new_window(argv) else []
    return launch(target, extra_args=extra)


if __name__ == "__main__":
    sys.exit(main(sys.argv))
