#!/usr/bin/env python3
"""thor-code — open a folder in Thor (code . equivalent).

Writes to Thor's pending-root handoff.
"""

from __future__ import annotations

import os
import subprocess
import sys

USAGE = "usage: thor-code [folder]"

VERSION = "0.1.0"

def _pending_path() -> str:
    try:
        from thor import xdg
        return xdg.pending_root_path()
    except Exception:
        pass
    # Fallback if thor package is not in python path
    env = os.environ.get("XDG_CACHE_HOME", "").strip()
    if env:
        return os.path.join(os.path.abspath(env), "thor", "project-mode", "pending-root")
    try:
        import gi  # type: ignore

        gi.require_version("Gtk", "3.0")  # type: ignore[attr-defined]
        from gi.repository import GLib  # type: ignore

        if GLib is not None:
            try:
                base = GLib.get_user_cache_dir()  # type: ignore[union-attr]
                if base:
                    return os.path.join(base, "thor", "project-mode", "pending-root")
            except Exception:
                pass
    except Exception:
        pass
    base = os.path.join(os.path.expanduser("~"), ".cache")
    return os.path.join(base, "thor", "project-mode", "pending-root")

def resolve_target(argv: list[str]) -> str | None:
    args = [a for a in argv[1:] if a not in ("--new-window", "-n")]
    if not args:
        return os.path.abspath(".")
    if args[0] in ("-h", "--help", "--version"):
        return None
    return os.path.abspath(os.path.expanduser(args[0]))


def launch(target: str) -> int:
    if not os.path.isdir(target):
        print(f"thor-code: not a folder: {target}", file=sys.stderr)
        return 2
    pending = _pending_path()
    try:
        os.makedirs(os.path.dirname(pending), exist_ok=True)
        # Atomic, last-writer-wins: concurrent thor-code invocations each
        # write a complete tmp file then os.replace() it, so readers never
        # see a partial path. No locking; the last replace wins by design.
        tmp = f"{pending}.tmp-{os.getpid()}"
        with open(tmp, "w", encoding="utf-8") as f:
            f.write(target + "\n")
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, pending)
    except OSError as exc:
        print(f"thor-code: failed to record folder: {exc}", file=sys.stderr)
        return 1
    # Launch thor (this process's thor-cli or installed thor)
    thor_bin = os.path.join(os.path.dirname(__file__), "thor-cli")
    if not os.path.isfile(thor_bin):
        thor_bin = "thor"
    try:
        subprocess.Popen(
            [sys.executable, thor_bin, target] if os.path.isfile(thor_bin) and thor_bin.endswith("thor-cli") else [thor_bin, target],
            cwd=target,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    except FileNotFoundError:
        print("thor-code: thor not on PATH", file=sys.stderr)
        return 127
    except OSError as exc:
        print(f"thor-code: failed to launch thor: {exc}", file=sys.stderr)
        return 1
    return 0

def main(argv: list[str]) -> int:
    if len(argv) > 1 and argv[1] in ("--version", "-v"):
        print(f"thor-code {VERSION}")
        return 0
    target = resolve_target(argv)
    if target is None:
        print(USAGE)
        return 0
    return launch(target)


if __name__ == "__main__":
    sys.exit(main(sys.argv))
