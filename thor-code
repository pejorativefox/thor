#!/usr/bin/env python3
"""thor-code — open a folder in Thor (code . equivalent).

Each window is its own process: this only spawns `thor <folder>`.
The child enforces the same-root lock gate itself and refuses a
second window for an already-live root.
"""

from __future__ import annotations

import os
import subprocess
import sys

USAGE = "usage: thor-code [folder]"

VERSION = "0.1.0"

def resolve_target(argv: list[str]) -> str | None:
    args = [a for a in argv[1:] if a not in ("--new-window", "-n")]
    if not args:
        return os.path.abspath(".")
    if args[0] in ("-h", "--help", "--version"):
        return None
    return os.path.abspath(os.path.expanduser(args[0]))


def launch(target: str) -> int:
    if not os.path.isdir(target):
        print(f"thor-code: not a folder: {target}", file=sys.stderr)
        return 2
    # Isolated processes: no pending-root handoff file anymore. Just
    # launch thor; the child takes the same-root lock or refuses.
    # Launch thor (this process's thor-cli or installed thor)
    thor_bin = os.path.join(os.path.dirname(__file__), "thor-cli")
    if not os.path.isfile(thor_bin):
        thor_bin = "thor"
    try:
        subprocess.Popen(
            [sys.executable, thor_bin, target] if os.path.isfile(thor_bin) and thor_bin.endswith("thor-cli") else [thor_bin, target],
            cwd=target,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    except FileNotFoundError:
        print("thor-code: thor not on PATH", file=sys.stderr)
        return 127
    except OSError as exc:
        print(f"thor-code: failed to launch thor: {exc}", file=sys.stderr)
        return 1
    return 0

def main(argv: list[str]) -> int:
    if len(argv) > 1 and argv[1] in ("--version", "-v"):
        print(f"thor-code {VERSION}")
        return 0
    target = resolve_target(argv)
    if target is None:
        print(USAGE)
        return 0
    return launch(target)


if __name__ == "__main__":
    sys.exit(main(sys.argv))
